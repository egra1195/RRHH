<?xml version="1.0" encoding="UTF-8"?>
<!--
  Despliegue en C:\inetpub\wwwroot\RRHH, mismo patron que Ficha_Medicos.
  IIS no ejecuta la aplicacion: lanza Node y le pasa el trafico (httpPlatform).

  Las cuentas de base de datos son PROVISIONALES y deben sustituirse por cuentas de
  permisos minimos: SARDB es sysadmin del servidor de datos y sa lo es del directorio.
  IIS nunca sirve este archivo como contenido, a diferencia de los .php del sistema
  anterior, que llevaban la clave en texto plano dentro de la raiz web.

  Sin comentarios dentro de <environmentVariables>: con ellos, IIS descartaba en
  silencio las variables que venian a continuacion.
-->
<configuration>
  <system.webServer>
    <httpPlatform processPath="C:\Windows\System32\cmd.exe"
                  arguments="/d /c C:\inetpub\wwwroot\RRHH\start-node.cmd"
                  startupTimeLimit="180"
                  startupRetryCount="3"
                  requestTimeout="00:10:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\wwwroot\RRHH\logs\httpplatform"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="APP_ENV" value="production" />
        <environmentVariable name="APP_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="APP_BASE" value="/RRHH" />
        <environmentVariable name="SESSION_DIR" value="C:\ProgramData\GMSP\RRHH\sessions" />
        <environmentVariable name="SESSION_TTL_SECONDS" value="28800" />
        <environmentVariable name="RRHH_DB_SERVER" value="localhost" />
        <environmentVariable name="RRHH_DB_PORT" value="1433" />
        <environmentVariable name="RRHH_DB_NAME" value="SARA6" />
        <environmentVariable name="RRHH_DB_USER" value="SARDB" />
        <environmentVariable name="RRHH_DB_PASS" value="SARDB" />
        <environmentVariable name="RRHH_AUTH_SERVER" value="10.16.194.203" />
        <environmentVariable name="RRHH_AUTH_PORT" value="1433" />
        <environmentVariable name="RRHH_AUTH_NAME" value="GSSPRO_CMDSP" />
        <environmentVariable name="RRHH_AUTH_USER" value="sa" />
        <environmentVariable name="RRHH_AUTH_PASS" value="GMSP2025**" />
        <environmentVariable name="REQUIRED_MENU_ID" value="582" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>

